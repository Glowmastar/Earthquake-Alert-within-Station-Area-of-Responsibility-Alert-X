# Copy to .env and replace the password consistently in both variables.
POSTGRES_PASSWORD=replace-with-a-long-database-password
DATABASE_URL=postgresql://alertx:replace-with-a-long-database-password@localhost:5432/alertx
NODE_ENV=development
APP_ORIGIN=http://localhost:3000
PORT=4000
# Set production + HTTPS origin behind your reverse proxy for Secure cookies.
TRUST_PROXY=0
SESSION_HOURS=8
DB_SSL=false
# DB_CA_FILE=/absolute/path/to/database-ca.pem

# External actions are disabled until explicitly configured.
INGESTION_ENABLED=false
# Immutable raw PHIVOLCS page archive. DATABASE is suitable for local development;
# use S3 in production after creating a private bucket and credentials.
RAW_ARCHIVE_BACKEND=DATABASE
# S3_BUCKET=alertx-source-archive
# S3_REGION=ap-southeast-1
# S3_ENDPOINT=https://s3.ap-southeast-1.amazonaws.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true
DELIVERY_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# Optional approved identity provider. Leave all blank to use local sessions.
# OIDC_ISSUER=https://your-approved-provider.example/issuer
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=

# Optional licensed map tile URL and attribution. Set before npm run build.
# VITE_TILE_URL=https://your-map-provider.example/{z}/{x}/{y}.png
# VITE_TILE_ATTRIBUTION=Your map provider attribution

# Bootstrap once, then remove the password from .env.
INITIAL_ADMIN_EMAIL=your-admin@example.org
INITIAL_ADMIN_NAME=Alert X Administrator
INITIAL_ADMIN_PASSWORD=replace-with-your-own-password-of-at-least-14-characters
