{
  "name": "alertx",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "dev:client": "vite --host 0.0.0.0 --port 3000",
    "dev:server": "node --watch --import tsx server/src/index.ts",
    "dev:worker": "node --watch --import tsx server/src/worker.ts",
    "build": "npm run check && vite build && esbuild server.ts --bundle --platform=node --format=esm --packages=external --outfile=server.js && tsc -p server/tsconfig.build.json",
    "check": "tsc --noEmit && tsc --noEmit -p server/tsconfig.json",
    "check:render": "node scripts/validate-render.mjs",
    "start": "node server.js",
    "start:api": "node build/server/index.js",
    "worker": "node build/server/worker.js",
    "db:migrate": "node --import tsx server/src/migrate.ts",
    "db:bootstrap": "node --import tsx server/src/bootstrap.ts",
    "db:verify": "node --import tsx server/src/verify-deployment.ts",
    "deploy:verify": "node build/server/verify-deployment.js",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:integration": "node --import tsx --test tests/integration/*.test.ts"
  },
  "dependencies": {
    "cheerio": "^1.1.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.0.0",
    "helmet": "^8.1.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "nodemailer": "^10.0.10",
    "openid-client": "^6.0.0",
    "pg": "^8.16.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-leaflet": "^5.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-postgis": "^0.2.8",
    "@tailwindcss/vite": "^4.0.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.0",
    "@types/leaflet": "^1.9.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^7.0.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/supertest": "^6.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "esbuild": "^0.25.0",
    "supertest": "^7.0.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "vite": "^7.0.0",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=22.12"
  }
}
